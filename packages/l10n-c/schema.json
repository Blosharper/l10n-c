{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/l10n-c/schema.json",
  "title": "l10n-c configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "localesDir": {
      "type": "string",
      "minLength": 1,
      "default": "public/locales"
    },
    "baseLanguage": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "default": "ko"
    },
    "sourcePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIgnore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referencePrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languageOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedRoots": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      }
    }
  }
}
