{
  "name": "vite-plugin-l10n-c",
  "version": "0.2.1",
  "description": "Development-only Vite translation manager for l10n-c",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "ui/index.html",
    "ui/app.js"
  ],
  "scripts": {
    "build": "tsup && esbuild ui/app.ts --bundle --format=esm --target=es2022 --outfile=ui/app.js",
    "prepublishOnly": "npm run build"
  },
  "author": "firejune",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blosharper/l10n-c.git",
    "directory": "packages/vite-plugin-l10n-c"
  },
  "bugs": {
    "url": "https://github.com/Blosharper/l10n-c/issues"
  },
  "homepage": "https://github.com/Blosharper/l10n-c#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "l10n-c": "^0.2.1"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
